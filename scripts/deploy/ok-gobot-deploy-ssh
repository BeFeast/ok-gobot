#!/bin/sh
# Restricted SSH forced command for the ok-gobot deploy key. This account must
# have no general sudo access; sudoers should permit only the installer below.
set -efu
set -f

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

installer=/usr/local/sbin/ok-gobot-install-release
original_command=${SSH_ORIGINAL_COMMAND-}

# Split only the four fixed command fields.
old_ifs=$IFS
IFS=' '
set -- $original_command
IFS=$old_ifs

if [ "$#" -ne 4 ] || [ "$1" != "deploy" ]; then
	echo "denied: expected deploy <tag> <commit> <sha256>" >&2
	exit 64
fi

tag=$2
commit=$3
binary_sha256=$4

case "$tag" in
	*[!v0-9.]* ) echo "denied: unsafe tag" >&2; exit 64 ;;
esac
printf '%s\n' "$tag" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || {
	echo "denied: tag must be stable SemVer" >&2
	exit 64
}
if [ "${#commit}" -ne 40 ]; then
	echo "denied: commit must be a full SHA-1" >&2
	exit 64
fi
case "$commit" in
	*[!0-9a-f]* ) echo "denied: invalid commit" >&2; exit 64 ;;
esac
if [ "${#binary_sha256}" -ne 64 ]; then
	echo "denied: invalid SHA-256 length" >&2
	exit 64
fi
case "$binary_sha256" in
	*[!0-9a-f]* ) echo "denied: invalid SHA-256" >&2; exit 64 ;;
esac

exec /usr/bin/sudo -n "$installer" "$tag" "$commit" "$binary_sha256"
