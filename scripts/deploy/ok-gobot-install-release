#!/bin/sh
# Root-only receiver for a verified ok-gobot binary streamed on stdin.
set -efu
set -f

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

config_file=/etc/ok-gobot/deploy.conf
lock_file=/run/lock/ok-gobot-deploy.lock
max_binary_bytes=268435456

fail() {
	echo "deploy failed: $*" >&2
	exit 1
}

[ "$(id -u)" -eq 0 ] || fail "installer must run as root"
[ "$#" -eq 3 ] || fail "expected <tag> <commit> <sha256>"

tag=$1
commit=$2
expected_sha256=$3

case "$tag" in
	*[!v0-9.]* ) fail "unsafe tag" ;;
esac
printf '%s\n' "$tag" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || fail "tag must be stable SemVer"
[ "${#commit}" -eq 40 ] || fail "commit must be a full SHA-1"
case "$commit" in
	*[!0-9a-f]* ) fail "invalid commit" ;;
esac
[ "${#expected_sha256}" -eq 64 ] || fail "invalid SHA-256 length"
case "$expected_sha256" in
	*[!0-9a-f]* ) fail "invalid SHA-256" ;;
esac

[ -f "$config_file" ] || fail "missing root-owned deploy config"
[ ! -L "$config_file" ] || fail "deploy config must not be a symlink"
[ "$(stat -c %u "$config_file")" = "0" ] || fail "deploy config must be root-owned"
[ -z "$(find "$config_file" -maxdepth 0 -perm /022 -print -quit)" ] || fail "deploy config must not be group/world writable"

deploy_root=""
release_base_url=""
service=""
runtime_user=""
runtime_group=""
runtime_home=""
runtime_workdir=""
runtime_env=""
runtime_codex_home=""
runtime_path=""

while IFS= read -r config_line || [ -n "$config_line" ]; do
	case "$config_line" in
		"" | \#* ) continue ;;
		*=* ) ;;
		* ) fail "invalid deploy config line" ;;
	esac
	config_key=${config_line%%=*}
	config_value=${config_line#*=}
	[ -n "$config_value" ] || fail "empty deploy config value for $config_key"
	case "$config_key" in
		DEPLOY_ROOT ) [ -z "$deploy_root" ] || fail "duplicate DEPLOY_ROOT"; deploy_root=$config_value ;;
		RELEASE_BASE_URL ) [ -z "$release_base_url" ] || fail "duplicate RELEASE_BASE_URL"; release_base_url=$config_value ;;
		SERVICE_UNIT ) [ -z "$service" ] || fail "duplicate SERVICE_UNIT"; service=$config_value ;;
		RUNTIME_USER ) [ -z "$runtime_user" ] || fail "duplicate RUNTIME_USER"; runtime_user=$config_value ;;
		RUNTIME_GROUP ) [ -z "$runtime_group" ] || fail "duplicate RUNTIME_GROUP"; runtime_group=$config_value ;;
		RUNTIME_HOME ) [ -z "$runtime_home" ] || fail "duplicate RUNTIME_HOME"; runtime_home=$config_value ;;
		RUNTIME_WORKDIR ) [ -z "$runtime_workdir" ] || fail "duplicate RUNTIME_WORKDIR"; runtime_workdir=$config_value ;;
		RUNTIME_ENV_FILE ) [ -z "$runtime_env" ] || fail "duplicate RUNTIME_ENV_FILE"; runtime_env=$config_value ;;
		RUNTIME_CODEX_HOME ) [ -z "$runtime_codex_home" ] || fail "duplicate RUNTIME_CODEX_HOME"; runtime_codex_home=$config_value ;;
		RUNTIME_PATH ) [ -z "$runtime_path" ] || fail "duplicate RUNTIME_PATH"; runtime_path=$config_value ;;
		* ) fail "unknown deploy config key: $config_key" ;;
	esac
done < "$config_file"

for required_value in \
	"$deploy_root" \
	"$release_base_url" \
	"$service" \
	"$runtime_user" \
	"$runtime_group" \
	"$runtime_home" \
	"$runtime_workdir" \
	"$runtime_env" \
	"$runtime_codex_home" \
	"$runtime_path"; do
	[ -n "$required_value" ] || fail "deploy config is incomplete"
done

for absolute_path in "$deploy_root" "$runtime_home" "$runtime_workdir" "$runtime_env" "$runtime_codex_home"; do
	case "$absolute_path" in
		/* ) ;;
		* ) fail "deploy config paths must be absolute" ;;
	esac
	case "/$absolute_path/" in
		*/../* | */./* ) fail "deploy config paths must not contain dot segments" ;;
	esac
done
[ "$deploy_root" != "/" ] || fail "DEPLOY_ROOT must not be filesystem root"

release_base_url=${release_base_url%/}
case "$release_base_url" in
	https://[A-Za-z0-9]* ) ;;
	* ) fail "RELEASE_BASE_URL must use HTTPS" ;;
esac
case "$release_base_url" in
	*[!A-Za-z0-9:./_-]* ) fail "RELEASE_BASE_URL contains unsafe characters" ;;
esac
case "$service" in
	"" | -* | *[!A-Za-z0-9@_.-]* ) fail "unsafe SERVICE_UNIT" ;;
esac
case "$runtime_user" in
	"" | -* | *[!A-Za-z0-9_.-]* ) fail "unsafe RUNTIME_USER" ;;
esac
case "$runtime_group" in
	"" | -* | *[!A-Za-z0-9_.-]* ) fail "unsafe RUNTIME_GROUP" ;;
esac
case "$runtime_path" in
	:* | *: | *::* | *[!A-Za-z0-9_./:+-]* ) fail "unsafe RUNTIME_PATH" ;;
esac

old_ifs=$IFS
IFS=:
set -- $runtime_path
IFS=$old_ifs
[ "$#" -gt 0 ] || fail "RUNTIME_PATH is empty"
for runtime_path_entry in "$@"; do
	case "$runtime_path_entry" in
		/* ) ;;
		* ) fail "RUNTIME_PATH entries must be absolute" ;;
	esac
	case "/$runtime_path_entry/" in
		*/../* | */./* ) fail "RUNTIME_PATH entries must not contain dot segments" ;;
	esac
done

[ -d "$deploy_root" ] || fail "DEPLOY_ROOT must be provisioned before deployment"
[ ! -L "$deploy_root" ] || fail "DEPLOY_ROOT must not be a symlink"
[ "$(realpath -e "$deploy_root")" = "$deploy_root" ] || fail "DEPLOY_ROOT must be canonical and contain no symlink components"
[ "$(stat -c %u "$deploy_root")" = "0" ] || fail "DEPLOY_ROOT must be root-owned"
[ -z "$(find "$deploy_root" -maxdepth 0 -perm /022 -print -quit)" ] || fail "DEPLOY_ROOT must not be group/world writable"

release_root="$deploy_root/releases"
current_link="$deploy_root/current"
install -d -o root -g root -m 0755 "$release_root"
[ ! -L "$release_root" ] || fail "release root must not be a symlink"
[ "$(realpath -e "$release_root")" = "$release_root" ] || fail "release root must be canonical and contain no symlink components"
[ "$(stat -c %u "$release_root")" = "0" ] || fail "release root must be root-owned"
[ -z "$(find "$release_root" -maxdepth 0 -perm /022 -print -quit)" ] || fail "release root must not be group/world writable"

if [ -e "$current_link" ] || [ -L "$current_link" ]; then
	[ -L "$current_link" ] || fail "current path must be a symlink"
	current_target=$(realpath -e "$current_link") || fail "current symlink target is missing"
	case "$current_target" in
		"$release_root"/* ) ;;
		* ) fail "current symlink must resolve inside release root" ;;
	esac
fi

exec 9> "$lock_file"
flock -n 9 || fail "another deployment is already running"

[ -d "$runtime_home" ] || fail "runtime home is missing"
[ -d "$runtime_workdir" ] || fail "runtime working directory is missing"
[ -f "$runtime_env" ] || fail "runtime environment file is missing"
[ -d "$runtime_codex_home" ] || fail "runtime CODEX_HOME is missing"
id "$runtime_user" >/dev/null 2>&1 || fail "runtime user does not exist"
getent group "$runtime_group" >/dev/null 2>&1 || fail "runtime group does not exist"

incoming=$(mktemp -d "$release_root/.incoming-${tag}.XXXXXX")
link_tmp=""
journal_tmp=""
checksum_tmp=""
metadata_dir=""
cleanup() {
	if [ -n "$link_tmp" ] && [ -L "$link_tmp" ]; then
		rm -f "$link_tmp"
	fi
	if [ -n "$incoming" ] && [ -d "$incoming" ]; then
		rm -rf "$incoming"
	fi
	if [ -n "$journal_tmp" ] && [ -f "$journal_tmp" ]; then
		rm -f "$journal_tmp"
	fi
	if [ -n "$checksum_tmp" ] && [ -f "$checksum_tmp" ]; then
		rm -f "$checksum_tmp"
	fi
	if [ -n "$metadata_dir" ] && [ -d "$metadata_dir" ]; then
		rm -rf "$metadata_dir"
	fi
}
trap cleanup EXIT HUP INT TERM

binary="$incoming/ok-gobot"
dd iflag=fullblock of="$binary" bs=1048576 count=257 status=none
binary_size=$(wc -c < "$binary" | tr -d ' ')
[ "$binary_size" -gt 0 ] || fail "empty binary"
[ "$binary_size" -le "$max_binary_bytes" ] || fail "binary exceeds size limit"
chmod 0755 "$binary"
chmod 0755 "$incoming"
chown root:root "$binary" "$incoming"

actual_sha256=$(sha256sum "$binary" | awk '{print $1}')
[ "$actual_sha256" = "$expected_sha256" ] || fail "binary SHA-256 mismatch"

binary_checksum_asset="ok-gobot_${tag}_linux_amd64.binary.sha256"
checksum_url="$release_base_url/$tag/$binary_checksum_asset"
checksum_tmp=$(mktemp "$deploy_root/.release-checksum-${tag}.XXXXXX")
curl \
	--disable \
	--fail \
	--silent \
	--show-error \
	--location \
	--proto '=https' \
	--proto-redir '=https' \
	--connect-timeout 10 \
	--max-filesize 4096 \
	--max-time 30 \
	--output "$checksum_tmp" \
	"$checksum_url" || fail "failed to fetch immutable Release checksum"

remote_checksum_record=$(sed -n '1p' "$checksum_tmp")
[ -n "$remote_checksum_record" ] || fail "Release checksum is empty"
[ -z "$(sed -n '2p' "$checksum_tmp")" ] || fail "Release checksum must contain exactly one record"
old_ifs=$IFS
IFS=' '
set -- $remote_checksum_record
IFS=$old_ifs
[ "$#" -eq 2 ] || fail "Release checksum has an invalid record"
release_sha256=$1
release_filename=$2
[ "$release_filename" = "ok-gobot" ] || fail "Release checksum names an unexpected artifact"
[ "${#release_sha256}" -eq 64 ] || fail "Release checksum has an invalid SHA-256 length"
case "$release_sha256" in
	*[!0-9a-f]* ) fail "Release checksum has an invalid SHA-256" ;;
esac
[ "$release_sha256" = "$expected_sha256" ] || fail "deploy request does not match immutable Release checksum"
[ "$release_sha256" = "$actual_sha256" ] || fail "streamed binary does not match immutable Release checksum"
rm -f "$checksum_tmp"
checksum_tmp=""

run_as_runtime() {
	runuser -u "$runtime_user" -- env -i \
		HOME="$runtime_home" \
		CODEX_HOME="$runtime_codex_home" \
		OKGOBOT_STORAGE_PATH="$metadata_dir/ok-gobot.db" \
		PATH="$runtime_path" \
		"$@"
}

metadata_dir=$(mktemp -d "$deploy_root/.metadata-${tag}.XXXXXX")
chown "$runtime_user:$runtime_group" "$metadata_dir"
chmod 0700 "$metadata_dir"

commit_short=$(printf '%.12s' "$commit")
version_output=$(run_as_runtime "$binary" version) || fail "binary version command failed"
case "$version_output" in
	*"$tag"* ) ;;
	* ) fail "embedded version does not match tag" ;;
esac
case "$version_output" in
	*"$commit_short"* ) ;;
	* ) fail "embedded commit does not match release commit" ;;
esac

release_dir="$release_root/${tag}-${commit_short}"
if [ -e "$release_dir" ]; then
	[ ! -L "$release_dir" ] || fail "existing release path must not be a symlink"
	[ -d "$release_dir" ] || fail "release path exists but is not a directory"
	[ "$(stat -c %u "$release_dir")" = "0" ] || fail "existing release must be root-owned"
	[ "$(stat -c %a "$release_dir")" = "755" ] || fail "existing release must have mode 0755"
	[ ! -L "$release_dir/ok-gobot" ] || fail "existing release binary must not be a symlink"
	[ -f "$release_dir/ok-gobot" ] || fail "existing release has no binary"
	[ "$(stat -c %u "$release_dir/ok-gobot")" = "0" ] || fail "existing release binary must be root-owned"
	[ "$(stat -c %a "$release_dir/ok-gobot")" = "755" ] || fail "existing release binary must have mode 0755"
	existing_sha256=$(sha256sum "$release_dir/ok-gobot" | awk '{print $1}')
	[ "$existing_sha256" = "$expected_sha256" ] || fail "existing immutable release differs"
else
	mv "$incoming" "$release_dir"
	incoming=""
fi

link_tmp="$deploy_root/.current-${tag}-$$"
[ ! -e "$link_tmp" ] && [ ! -L "$link_tmp" ] || fail "temporary link already exists"
ln -s "$release_dir" "$link_tmp"
mv -Tf "$link_tmp" "$current_link"
link_tmp=""

restart_epoch=$(date +%s)
systemctl restart "$service"
sleep 3
systemctl is-active --quiet "$service" || fail "service is not active after restart"

active_state=$(systemctl show "$service" --property=ActiveState --value)
sub_state=$(systemctl show "$service" --property=SubState --value)
restart_count=$(systemctl show "$service" --property=NRestarts --value)
[ "$active_state" = "active" ] || fail "unexpected ActiveState=$active_state"
[ "$sub_state" = "running" ] || fail "unexpected SubState=$sub_state"
[ "$restart_count" = "0" ] || fail "unexpected NRestarts=$restart_count"

deployed_version=$(run_as_runtime "$current_link/ok-gobot" version) || fail "deployed version check failed"
case "$deployed_version" in
	*"$tag"*"$commit_short"* ) ;;
	* ) fail "current symlink points to unexpected binary" ;;
esac
rm -rf "$metadata_dir"
metadata_dir=""

doctor_unit="ok-gobot-deploy-doctor-${commit_short}-$$"
systemd-run \
	--quiet \
	--wait \
	--collect \
	--unit="$doctor_unit" \
	--property="User=$runtime_user" \
	--property="Group=$runtime_group" \
	--property="WorkingDirectory=$runtime_workdir" \
	--property="EnvironmentFile=$runtime_env" \
	--property="StandardOutput=null" \
	--property="StandardError=null" \
	--setenv="HOME=$runtime_home" \
	--setenv="CODEX_HOME=$runtime_codex_home" \
	--setenv="PATH=$runtime_path" \
	"$current_link/ok-gobot" doctor || fail "doctor failed"

journal_tmp=$(mktemp "$deploy_root/.journal-${tag}.XXXXXX")
journalctl -u "$service" --since="@$restart_epoch" --priority=err --no-pager --output=cat > "$journal_tmp" || fail "journal verification failed"
journal_errors=$(wc -l < "$journal_tmp" | tr -d ' ')
[ "$journal_errors" = "0" ] || fail "service journal contains post-restart errors"
rm -f "$journal_tmp"
journal_tmp=""

systemctl is-active --quiet "$service" || fail "service stopped during post-restart checks"
restart_count=$(systemctl show "$service" --property=NRestarts --value)
[ "$restart_count" = "0" ] || fail "service restarted during post-restart checks"

printf 'deployed tag=%s commit=%s sha256=%s\n' "$tag" "$commit" "$expected_sha256"
printf 'service=%s ActiveState=%s SubState=%s NRestarts=%s journal_errors=%s\n' \
	"$service" "$active_state" "$sub_state" "$restart_count" "$journal_errors"
